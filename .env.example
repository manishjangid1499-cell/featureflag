# Used only by the Compose MySQL container during first initialization.
MYSQL_ROOT_PASSWORD=

# Application database credentials are service-specific. Initialization runs only
# while mysql-data is empty; later .env changes do not update existing users.
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=

# Host paths to externally managed RSA key files. Do not store keys in this repository.
# On Linux, these files must be readable by the backend runtime UID/GID 10001.
AUTH_JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=feature-flag-auth
JWT_AUDIENCE=feature-flag-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_KEY_ID=featureflag-key-1
AUTH_RECIPIENTS_SERVICE_KEY=

# Browser-facing production frontend origin and the only public application port.
# Replace localhost with the real deployed origin outside local portfolio use.
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_PORT=3000

# Optional host tooling access; Kafka is bound to host loopback only.
KAFKA_EXTERNAL_PORT=9092

FLAG_DB_USERNAME=
FLAG_DB_PASSWORD=

ANALYTICS_DB_USERNAME=
ANALYTICS_DB_PASSWORD=

AUDIT_DB_USERNAME=
AUDIT_DB_PASSWORD=

NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_MAIL_USERNAME=
NOTIFICATION_MAIL_PASSWORD=
NOTIFICATION_MAIL_CONNECTION_TIMEOUT_MS=10000
NOTIFICATION_MAIL_READ_TIMEOUT_MS=10000
NOTIFICATION_MAIL_WRITE_TIMEOUT_MS=10000

BOOTSTRAP_OWNER_ENABLED=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
