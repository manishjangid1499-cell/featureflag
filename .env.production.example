# ==============================================================================
# Feature Flag Platform - Production Environment Configuration Template
# Target: Ubuntu 24.04 ARM64 (1 OCPU / 1 core, 7 GB RAM)
# Domain: featureflags.duckdns.org (Public IP: 168.138.115.124)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to a private deployment path outside Git, e.g.:
#    cp .env.production.example /home/ubuntu/secrets/.env
#    chmod 600 /home/ubuntu/secrets/.env
# 2. Populate all missing secret values using strong, randomly generated strings.
# 3. Never commit real production secrets or private keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Edge Reverse Proxy & TLS Configuration
# ------------------------------------------------------------------------------
# Host path to the Let's Encrypt directory tree.
# The entire tree (/etc/letsencrypt) is mounted read-only so that live -> archive
# symlinks resolve properly inside the edge-proxy container.
LETSENCRYPT_DIR=/etc/letsencrypt

# Host directory used by Certbot for webroot ACME challenge renewals
ACME_WEBROOT_DIR=/home/ubuntu/feature-flag-platform/acme-challenge

# ------------------------------------------------------------------------------
# 2. Public Frontend Origin & CORS
# ------------------------------------------------------------------------------
# Deployed origin for the browser-facing Single Page Application.
# Used by Auth Service to construct invitation and password reset email links.
FRONTEND_BASE_URL=https://featureflags.duckdns.org

# Allowed browser origins for Spring Cloud Gateway, Flag Service, and Audit Service.
CORS_ALLOWED_ORIGINS=https://featureflags.duckdns.org

# ------------------------------------------------------------------------------
# 3. MySQL Database Credentials
# ------------------------------------------------------------------------------
# Used by the MySQL container only during first-time initialization.
MYSQL_ROOT_PASSWORD=

# Service database usernames and passwords.
# Constraints: Usernames must contain 1-32 alphanumeric characters / underscores,
# must NOT be 'root', and must be unique per service.
AUTH_DB_USERNAME=auth_service_user
AUTH_DB_PASSWORD=

FLAG_DB_USERNAME=flag_service_user
FLAG_DB_PASSWORD=

AUDIT_DB_USERNAME=audit_service_user
AUDIT_DB_PASSWORD=

ANALYTICS_DB_USERNAME=analytics_service_user
ANALYTICS_DB_PASSWORD=

NOTIFICATION_DB_USERNAME=notification_service_user
NOTIFICATION_DB_PASSWORD=

# ------------------------------------------------------------------------------
# 4. RSA Cryptographic Keypair & JWT Authentication
# ------------------------------------------------------------------------------
# Host paths to RSA PEM keys stored outside the Git repository.
# Host permissions must narrowly scope read access to container UID/GID 10001
# (e.g. `chown 10001:10001 /home/ubuntu/secrets/jwt-private.pem && chmod 600 ...`
#  or `chown root:10001 ... && chmod 640 ...`). Never use world-readable permissions.
AUTH_JWT_PRIVATE_KEY_FILE=/home/ubuntu/secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=/home/ubuntu/secrets/jwt-public.pem

JWT_ISSUER=feature-flag-auth
JWT_AUDIENCE=feature-flag-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_KEY_ID=featureflag-key-1

# ------------------------------------------------------------------------------
# 5. Internal Service-to-Service Authentication
# ------------------------------------------------------------------------------
# Shared internal token for inter-service communication between backend services.
# Generate strong, distinct 32+ character random strings.
AUTH_RECIPIENTS_SERVICE_KEY=
AUTH_INTERNAL_SERVICE_KEY=
NOTIFICATION_INTERNAL_SERVICE_KEY=

# ------------------------------------------------------------------------------
# 6. Notification Service Mail (SMTP) Settings
# ------------------------------------------------------------------------------
# SMTP credentials for sending invitation and password reset emails.
NOTIFICATION_MAIL_USERNAME=
NOTIFICATION_MAIL_PASSWORD=
NOTIFICATION_MAIL_CONNECTION_TIMEOUT_MS=10000
NOTIFICATION_MAIL_READ_TIMEOUT_MS=10000
NOTIFICATION_MAIL_WRITE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 7. Operational Budgets & Fallback Limits
# ------------------------------------------------------------------------------
REDIS_CONNECT_TIMEOUT=500ms
REDIS_COMMAND_TIMEOUT=500ms
EVALUATION_TELEMETRY_QUEUE_CAPACITY=256
KAFKA_MAX_BLOCK_MS=1000

# ------------------------------------------------------------------------------
# 8. Initial OWNER Bootstrap
# ------------------------------------------------------------------------------
# Set BOOTSTRAP_OWNER_ENABLED=true ONLY during first startup with an empty database.
# After the initial OWNER account is created, set this back to false, clear the
# bootstrap password, and restart auth-service.
BOOTSTRAP_OWNER_ENABLED=false
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
